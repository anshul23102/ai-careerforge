MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=Cluster0
PORT=3001
JWT_SECRET=<random-long-secret-string>
GROQ_API_KEY=<groq-api-key>
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=https://ai-careerforge.vercel.app

# Optional
# GITHUB_TOKEN=<personal-access-token>  # raises the GitHub API rate limit from 60/hr to 5,000/hr
# ALLOWED_ORIGINS=https://example.com,https://other.example.com  # extra CORS origins beyond the built-in defaults
